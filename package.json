{
  "name": "@wikicat/wikicat",
  "version": "1.0.0",
  "private": true,
  "description": "WikiCat - Internal documentation system (intranet)",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "dev": "pnpm -r --parallel --filter @wikicat/api --filter @wikicat/web --filter @wikicat/shared dev",
    "test": "pnpm -r test",
    "env:validate": "node scripts/validate-env.mjs",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "keywords": [
    "wiki",
    "documentation",
    "intranet"
  ],
  "author": "Infra Team",
  "license": "MIT",
  "dependencies": {
    "@sinclair/typebox": "^0.33.21",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "pnpm": "^9.15.0",
    "typescript": "^5.6.3",
    "eslint": "^8.57.1",
    "@typescript-eslint/parser": "^7.18.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "prettier": "^3.3.3"
  }
}
