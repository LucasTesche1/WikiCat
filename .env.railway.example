# Railway variables template.
# Values must be explicit. Do not paste variables that reference other variables.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/railway

JWT_SECRET=replace-with-unique-random-64-char-secret
COOKIE_SECRET=replace-with-unique-random-64-char-secret
SESSION_MAX_AGE_SECONDS=604800

PUBLIC_BASE_URL=https://your-app-domain.up.railway.app
WEB_ORIGIN=https://your-app-domain.up.railway.app

ATTACHMENTS_DIR=/attachments
ATTACHMENTS_LARGE_DIR=/attachments-large
MAX_ATTACHMENT_STANDARD_MB=20
MAX_ATTACHMENT_LARGE_MB=2048

INIT_ADMIN_EMAIL=admin@your-domain.com
INIT_ADMIN_PASSWORD=replace-with-strong-initial-admin-password
INIT_ADMIN_NAME=WikiCat Admin

RUN_MIGRATIONS_ON_STARTUP=true
DB_WAIT_TIMEOUT_SECONDS=180
# Set to require only if you use Railway public Postgres URL.
DB_SSL_MODE=
