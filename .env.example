# WikiCat environment template
TZ=UTC
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL
DB_PASSWORD=change-this-local-db-password
DB_PORT=5432
DATABASE_URL=postgres://wikicat:change-this-local-db-password@localhost:5432/wikicat

# Auth/session secrets. Use unique random values, 32+ chars.
JWT_SECRET=change-this-jwt-secret-32-plus-random-chars
COOKIE_SECRET=change-this-cookie-secret-32-plus-random-chars
SESSION_MAX_AGE_SECONDS=604800

# App URLs
PUBLIC_BASE_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000,http://localhost:5173
WIKICAT_DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443

# Storage
ATTACHMENTS_DIR=/attachments
ATTACHMENTS_LARGE_DIR=/attachments-large
MAX_ATTACHMENT_STANDARD_MB=20
MAX_ATTACHMENT_LARGE_MB=2048

# Initial admin seed
INIT_ADMIN_EMAIL=admin@example.com
INIT_ADMIN_PASSWORD=ChangeThisAdminPassword1
INIT_ADMIN_NAME=Administrator

RUN_MIGRATIONS_ON_STARTUP=true
DB_WAIT_TIMEOUT_SECONDS=180
# Set DB_SSL_MODE=require only when using a public Railway Postgres URL.
DB_SSL_MODE=
