:80 {
  encode gzip zstd

  header {
    X-Content-Type-Options nosniff
    X-Frame-Options SAMEORIGIN
    Referrer-Policy no-referrer-when-downgrade
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self';"
  }

  handle /api/* {
    reverse_proxy back-end:3000
  }

  handle /health {
    reverse_proxy back-end:3000
  }

  handle {
    reverse_proxy front-end:8080
  }
}
